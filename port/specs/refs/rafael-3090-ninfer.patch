+
+void packed_inkling_launch(const MoeVecArgs& p, int active, int chunk, cudaStream_t stream) {
+    auto launch = [&]<int K>() {
+        dim3 grid(p.rows / 8, active);
+        if (chunk == 1)
+            packed_kernel<K, 1><<<grid, 256, 0, stream>>>(p);
+        else if (chunk == 2)
+            packed_kernel<K, 2><<<grid, 256, 0, stream>>>(p);
+        else
+            packed_kernel<K, 4><<<grid, 256, 0, stream>>>(p);
+    };
+    if (p.k == 2304)
+        launch.template operator()<2304>();
+    else
+        launch.template operator()<1152>();
+    check(cudaGetLastError(), "packed Inkling NVFP4 product");
+}

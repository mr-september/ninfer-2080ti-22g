+                        static_cast<unsigned long long>(fixed_product(v, p.weights[pair[j]])));
+                else
+                    p.out_f32[std::int64_t(pair[j]) * p.rows + row] = v;
+            }
+        }
+        __syncthreads();
+    }
+}
+
+template <int K, bool Pack>
+__global__ void change_rows(const void* const* table, int rows) {
+    constexpr int S = K / 32, bytes = S * 18;
+    auto* base = static_cast<unsigned char*>(const_cast<void*>(table[blockIdx.y])) +
+                 std::int64_t(blockIdx.x) * bytes;
+    __shared__ __align__(16) unsigned char source[bytes];
+    for (int i = threadIdx.x; i < bytes / 4; i += 128)
+        reinterpret_cast<unsigned*>(source)[i] = reinterpret_cast<unsigned*>(base)[i];
+    __syncthreads();
+    for (int i = threadIdx.x; i < S * 4; i += 128) {
+        const int s = i % S, j = i / S, orig = (s / 2) * 9 + 1 + 4 * (s % 2) + j;
+        if constexpr (Pack)
+            reinterpret_cast<unsigned*>(base)[i] = reinterpret_cast<unsigned*>(source)[orig];
+        else
+            reinterpret_cast<unsigned*>(base)[orig] = reinterpret_cast<unsigned*>(source)[i];
+    }
+    if (threadIdx.x < S) {
+        const int s = threadIdx.x;
+        for (int i = 0; i < 2; ++i) {
+            const int orig = (s / 2) * 36 + 2 * (s % 2) + i, packed = S * 16 + 2 * s + i;
+            if constexpr (Pack) {
+                unsigned h   = __half_as_ushort(__float2half_rn(ue4m3_half(source[orig])));
+                base[packed] = source[orig] == 127 ? 255 : h >> 7;
+            } else {
+                unsigned u = source[packed], exponent = u >> 3, mant = u & 7;
+                base[orig] = u == 255        ? 127
+                             : exponent >= 8 ? ((exponent - 7) << 3) | mant
+                                             : (u ? ((8 + mant) >> (8 - exponent)) : 0);
+            }
+        }
+    }
+}

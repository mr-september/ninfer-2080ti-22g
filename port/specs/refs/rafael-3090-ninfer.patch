+struct WidthPolicy {
+    static constexpr unsigned capacity = 4;
+    std::array<unsigned, capacity> samples{};
+    std::array<double, capacity> seconds{};
+    std::array<double, capacity> conditional{1.0, 0.5, 0.5, 0.5};
+    std::array<unsigned, capacity> evidence{};
+    unsigned rounds = 0;
+
+    unsigned select(unsigned maximum) const {
+        maximum = std::min(maximum, capacity - 1);
+        for (unsigned w = 0; w <= maximum; ++w)
+            if (samples[w] < 3) return w;
+        double chance = 1.0, length = 1.0;
+        unsigned best  = 0;
+        double fastest = 1.0 / seconds[0];
+        for (unsigned w = 1; w <= maximum; ++w) {
+            chance *= conditional[w];
+            length += chance;
+            const double rate = length / seconds[w];
+            if (rate > fastest) {
+                fastest = rate;
+                best    = w;
+            }
+        }
+        // Occasional wide rounds measure the later positions even when the shorter
+        // width has been winning. A direct round refreshes the local cost as context grows.
+        if (rounds % 31 == 0) return maximum;
+        if (rounds % 59 == 0) return 0;
+        if (best == 0 && rounds % 9 == 0) return 1;
+        return best;
+    }
+
+    void observe(unsigned width, unsigned committed, double elapsed) {
+        if (width >= capacity || committed == 0 || !(elapsed > 0.0)) return;
+        ++rounds;
+        const unsigned n = ++samples[width];
+        if (n == 1 || n == 2)
+            seconds[width] = elapsed;
+        else
+            seconds[width] += (elapsed - seconds[width]) / std::min(n - 1, 24U);
+        for (unsigned i = 1; i <= width && committed >= i; ++i) {
+            const double kept   = committed > i ? 1.0 : 0.0;
+            const unsigned seen = ++evidence[i];
+            conditional[i] += (kept - conditional[i]) / std::min(seen + 4, 24U);
+        }
+    }
+};

+        break;
+    case 3:
+        launch.template operator()<3>();
+        break;
+    case 4:
+        launch.template operator()<4>();
+        break;
+    case 5:
+        launch.template operator()<5>();
+        break;
+    case 6:
+        launch.template operator()<6>();
+        break;
+    case 7:
+        launch.template operator()<7>();
+        break;
+    case 8:

+// Sixteen queries share each tile of 64 keys. Four warps form the score tiles, then
+// multiply the normalized weights by the cached values. The row maxima and sums stay FP32.
+__global__ __launch_bounds__(128) void prompt_attention_mma(AttentionArgs a) {
+#if __CUDA_ARCH__ >= 800
+    using namespace nvcuda::wmma;
+    constexpr int rows = 16, keys = 64, dim = 128;
+    __shared__ __align__(32) __half query[rows][dim];
+    __shared__ __align__(32) __half cache[keys][dim];
+    __shared__ __align__(32) __half probabilities[rows][keys];
+    __shared__ __align__(32) float tile[rows][dim];
+    __shared__ float maxima[rows], denom[rows], previous[rows];
+    const int tid = threadIdx.x, warp = tid / 32, lane = tid % 32;
+    const int row = tid / 8, sub = tid % 8;
+    const int t0 = blockIdx.x * rows, token = t0 + row, h = blockIdx.y;
+    const bool valid = token < a.rows.tokens;
+    const int kvh    = h / (a.query_heads / a.kv_heads);
+    const auto base =
+        std::int64_t(a.rows.sequence) * a.seq_stride + std::int64_t(kvh) * a.head_stride;
+    const auto qhead = std::int64_t(token) * a.query_heads + h;
+    float output[dim / 8]{};
+    for (int d = sub; d < dim; d += 8) {
+        query[row][d] = __float2half_rn(valid ? a.q[qhead * dim + d] * a.scale : 0.0f);
+    }
+    if (sub == 0) {
+        const float sink =
+            valid && a.sinks ? a.sinks[std::int64_t(token) * a.sink_stride + h] : -INFINITY;
+        maxima[row] = sink;
+        denom[row]  = isfinite(sink) ? 1.0f : 0.0f;
+    }
+    int first, last;
+    key_range(a, t0, min(t0 + rows, a.rows.tokens), first, last);
+    __syncthreads();
+    fragment<matrix_a, 16, 16, 16, __half, row_major> q[dim / 16];
+#    pragma unroll
+    for (int part = 0; part < dim / 16; ++part)
+        load_matrix_sync(q[part], &query[0][16 * part], dim);
+    for (int start = first; start <= last; start += keys) {
+        __syncthreads();
+        for (int i = tid; i < keys * dim / 8; i += 128) {

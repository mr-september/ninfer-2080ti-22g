+__device__ __forceinline__ int2 inkling_unpack(unsigned q) {
+    unsigned sel = 0x32103210u | ((q & 0x88888888u) >> 1);
+    unsigned lo  = __byte_perm(__byte_perm(0x03020100, 0x0c080604, q),
+                               __byte_perm(0xfdfeff00, 0xf4f8fafc, q), sel);
+    unsigned hi  = __byte_perm(__byte_perm(0x03020100, 0x0c080604, q >> 16),
+                               __byte_perm(0xfdfeff00, 0xf4f8fafc, q >> 16), sel >> 16);
+    return make_int2(__byte_perm(lo, hi, 0x6420), __byte_perm(lo, hi, 0x7531));
+}
+
+template <int K, int T>
+__global__ __launch_bounds__(256) void packed_kernel(MoeVecArgs p) {
+    if (blockIdx.y >= *p.active_count) return;
+    int expert = p.active[blockIdx.y], begin = p.bounds[expert], end = p.bounds[expert + 1];
+    constexpr int S = K / 32;
+    const int lane = threadIdx.x & 31, warp = threadIdx.x >> 5, row = blockIdx.x * 8 + warp;
+    const auto* root  = p.first[expert] + std::int64_t(row) * p.row_bytes;
+    const auto* words = reinterpret_cast<const unsigned*>(root);
+    __shared__ int aq[T][8][S + 1];
+    __shared__ float scale[T][S];
+    for (int c0 = begin; c0 < end; c0 += T) {
+        const int n = min(T, end - c0);
+        int pair[T];
+        for (int j = 0; j < T; ++j) pair[j] = p.sorted[c0 + min(j, n - 1)];
+        for (int j = 0; j < n; ++j) {
+            int col       = pair[j] / p.column_group;
+            const auto* q = reinterpret_cast<const int*>(p.qs + std::int64_t(col) * K);
+            for (int i = threadIdx.x; i < K / 4; i += 256) aq[j][i % 8][i / 8] = q[i];
+            if (threadIdx.x < S)
+                scale[j][threadIdx.x] = __low2float(p.ds[std::int64_t(col) * S + threadIdx.x]);
+        }
+        __syncthreads();
+        float acc[T]{};
+        for (int s = lane; s < S; s += 32) {
+            int w[8];
+            for (int i = 0; i < 4; ++i) {
+                const int2 z               = inkling_unpack(words[i * S + s]);
+                w[4 * (i / 2) + i % 2]     = z.x;
+                w[4 * (i / 2) + 2 + i % 2] = z.y;
+            }
+            const unsigned d  = reinterpret_cast<const unsigned short*>(words + 4 * S)[s];
+            const unsigned lo = d & 255u, hi = d >> 8;
+            const unsigned pairbits =
+                ((lo == 255u ? 0u : lo) << 7) | ((hi == 255u ? 0u : hi) << 23);
+            const float2 ds = __half22float2(*reinterpret_cast<const half2*>(&pairbits));
+            const float a = ds.x, b = ds.y;
+            for (int j = 0; j < n; ++j) {
+                int v0 = 0, v1 = 0;
+                for (int i = 0; i < 4; ++i) {
+                    v0 = __dp4a(w[i], aq[j][i][s], v0);
+                    v1 = __dp4a(w[4 + i], aq[j][4 + i][s], v1);
+                }

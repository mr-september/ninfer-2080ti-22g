+    const int lane                 = threadIdx.x & 31;
+    const int k                    = KS != 0 ? KS : p.k;
+    const int slices               = k / 32;
+    const int step                 = Fused ? 1 : kRows;
+    const std::int64_t lane_offset = std::int64_t(lane / kPerBlock) * D::kBlockBytes;
+    const int sub                  = lane % kPerBlock;

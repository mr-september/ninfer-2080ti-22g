{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "product",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "NINFER_BUILD_ENGINE": "ON",
        "NINFER_BUILD_APPS": "ON",
        "BUILD_TESTING": "OFF",
        "NINFER_BUILD_BENCHMARKS": "OFF"
      }
    },
    {
      "name": "turing-release",
      "displayName": "Turing (RTX 2080 Ti) product binaries",
      "inherits": "product"
    },
    {
      "name": "turing-dev",
      "displayName": "Turing products, tests and benchmarks",
      "inherits": "turing-release",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "NINFER_BUILD_BENCHMARKS": "ON"
      }
    },
    {
      "name": "turing-ops",
      "displayName": "Turing Core, Artifact and Ops development",
      "inherits": "turing-dev",
      "cacheVariables": {
        "NINFER_BUILD_ENGINE": "OFF",
        "NINFER_BUILD_APPS": "OFF"
      }
    },
    {
      "name": "turing-windows",
      "displayName": "Turing on native Windows (MSVC, vcpkg)",
      "inherits": "turing-release",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "turing-windows-dev",
      "displayName": "Turing on native Windows with tests and benchmarks",
      "inherits": "turing-windows",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "NINFER_BUILD_BENCHMARKS": "ON"
      }
    },
    {
      "name": "turing-windows-ops",
      "displayName": "Turing on native Windows, Core, Artifact and Ops development",
      "inherits": "turing-windows-dev",
      "cacheVariables": {
        "NINFER_BUILD_ENGINE": "OFF",
        "NINFER_BUILD_APPS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "turing-release",
      "configurePreset": "turing-release"
    },
    {
      "name": "turing-dev",
      "configurePreset": "turing-dev"
    },
    {
      "name": "turing-ops",
      "configurePreset": "turing-ops"
    },
    {
      "name": "turing-windows",
      "configurePreset": "turing-windows"
    },
    {
      "name": "turing-windows-dev",
      "configurePreset": "turing-windows-dev"
    }
  ],
  "testPresets": [
    {
      "name": "turing-dev",
      "configurePreset": "turing-dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "turing-ops",
      "configurePreset": "turing-ops",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "turing-windows-dev",
      "configurePreset": "turing-windows-dev",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}

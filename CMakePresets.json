{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Release product binaries",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "NINFER_BUILD_APPS": "ON",
        "BUILD_TESTING": "OFF",
        "NINFER_BUILD_BENCHMARKS": "OFF"
      }
    },
    {
      "name": "dev",
      "displayName": "Release products, tests and benchmarks",
      "inherits": "release",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "NINFER_BUILD_BENCHMARKS": "ON"
      }
    },
    {
      "name": "windows",
      "displayName": "Native Windows release (MSVC, vcpkg)",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build-windows",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_CUDA_ARCHITECTURES": "75"
      }
    },
    {
      "name": "windows-dev",
      "displayName": "Native Windows with tests and benchmarks",
      "inherits": "windows",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "NINFER_BUILD_BENCHMARKS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "windows",
      "configurePreset": "windows"
    },
    {
      "name": "windows-dev",
      "configurePreset": "windows-dev"
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-dev",
      "configurePreset": "windows-dev",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}

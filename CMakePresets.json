{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "product",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "NINFER_BUILD_ENGINE": "ON",
        "NINFER_BUILD_APPS": "ON",
        "BUILD_TESTING": "OFF",
        "NINFER_BUILD_BENCHMARKS": "OFF"
      }
    },
    {
      "name": "turing-release",
      "displayName": "Turing (RTX 2080 Ti) product binaries",
      "inherits": "product",
      "cacheVariables": {
        "NINFER_TARGET": "turing"
      }
    },
    {
      "name": "turing-dev",
      "displayName": "Turing products, tests and benchmarks",
      "inherits": "turing-release",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "NINFER_BUILD_BENCHMARKS": "ON"
      }
    },
    {
      "name": "turing-ops",
      "displayName": "Turing Core, Artifact and Ops development",
      "inherits": "turing-dev",
      "cacheVariables": {
        "NINFER_BUILD_ENGINE": "OFF",
        "NINFER_BUILD_APPS": "OFF"
      }
    },
    {
      "name": "turing-windows",
      "displayName": "Turing on native Windows (MSVC, vcpkg)",
      "inherits": "turing-release",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "turing-windows-dev",
      "displayName": "Turing on native Windows with tests and benchmarks",
      "inherits": "turing-windows",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "NINFER_BUILD_BENCHMARKS": "ON"
      }
    },
    {
      "name": "turing-windows-ops",
      "displayName": "Turing on native Windows, Core, Artifact and Ops development",
      "inherits": "turing-windows-dev",
      "cacheVariables": {
        "NINFER_BUILD_ENGINE": "OFF",
        "NINFER_BUILD_APPS": "OFF"
      }
    },
    {
      "name": "rtx5090-release",
      "displayName": "RTX 5090 product binaries",
      "inherits": "product",
      "cacheVariables": {
        "NINFER_TARGET": "rtx5090"
      }
    },
    {
      "name": "rtx5090-dev",
      "displayName": "RTX 5090 products, tests and benchmarks",
      "inherits": "rtx5090-release",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "NINFER_BUILD_BENCHMARKS": "ON"
      }
    },
    {
      "name": "rtx5090-ops",
      "displayName": "RTX 5090 Core, Artifact and Ops development",
      "inherits": "rtx5090-dev",
      "cacheVariables": {
        "NINFER_BUILD_ENGINE": "OFF",
        "NINFER_BUILD_APPS": "OFF"
      }
    },
    {
      "name": "dgx-spark-release",
      "displayName": "DGX Spark product binaries",
      "inherits": "product",
      "cacheVariables": {
        "NINFER_TARGET": "dgx_spark"
      }
    },
    {
      "name": "dgx-spark-dev",
      "displayName": "DGX Spark products, tests and benchmarks",
      "inherits": "dgx-spark-release",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "NINFER_BUILD_BENCHMARKS": "ON"
      }
    },
    {
      "name": "dgx-spark-ops",
      "displayName": "DGX Spark Core, Artifact and Ops development",
      "inherits": "dgx-spark-dev",
      "cacheVariables": {
        "NINFER_BUILD_ENGINE": "OFF",
        "NINFER_BUILD_APPS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "turing-release",
      "configurePreset": "turing-release"
    },
    {
      "name": "turing-dev",
      "configurePreset": "turing-dev"
    },
    {
      "name": "turing-ops",
      "configurePreset": "turing-ops"
    },
    {
      "name": "turing-windows",
      "configurePreset": "turing-windows"
    },
    {
      "name": "turing-windows-dev",
      "configurePreset": "turing-windows-dev"
    },
    {
      "name": "rtx5090-release",
      "configurePreset": "rtx5090-release"
    },
    {
      "name": "rtx5090-dev",
      "configurePreset": "rtx5090-dev"
    },
    {
      "name": "rtx5090-ops",
      "configurePreset": "rtx5090-ops"
    },
    {
      "name": "dgx-spark-ops",
      "configurePreset": "dgx-spark-ops"
    },
    {
      "name": "dgx-spark-release",
      "configurePreset": "dgx-spark-release"
    },
    {
      "name": "dgx-spark-dev",
      "configurePreset": "dgx-spark-dev"
    }
  ],
  "testPresets": [
    {
      "name": "turing-dev",
      "configurePreset": "turing-dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "turing-ops",
      "configurePreset": "turing-ops",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "turing-windows-dev",
      "configurePreset": "turing-windows-dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "rtx5090-dev",
      "configurePreset": "rtx5090-dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "rtx5090-ops",
      "configurePreset": "rtx5090-ops",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "dgx-spark-ops",
      "configurePreset": "dgx-spark-ops",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "dgx-spark-dev",
      "configurePreset": "dgx-spark-dev",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
